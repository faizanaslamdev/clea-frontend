# Local dev only — copy to .env.local. Production uses Vercel dashboard / .env.prod.
# Backend default port 3000. Run Next on 3001: npm run dev
NEXT_PUBLIC_API_URL=http://localhost:3000

# Better Auth — runs inside Next.js at /api/auth/[...all]
# Connects directly to Neon/Postgres (server-side only; never NEXT_PUBLIC_*).
# Generate secret: openssl rand -base64 64  (>= 32 characters; use 64+ bytes in prod)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Prefer AUTH_DATABASE_URL for clarity (auth-only). DATABASE_URL also works.
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clea
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clea
# DB_SSL=false

# Transactional email (Resend). Required in production.
# Optional in local/dev (emails log subject/to to the server console).
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Clea <noreply@clea.no>

# Production cookie strategy (defaults ON in production):
# Shares session cookies across www.clea.no and api.clea.no
# BETTER_AUTH_CROSS_SUBDOMAIN_COOKIES=true
# BETTER_AUTH_COOKIE_DOMAIN=.clea.no

# --- Vercel production checklist (dashboard; see also .env.prod) ---
# NEXT_PUBLIC_API_URL=https://api.clea.no
# BETTER_AUTH_URL=https://www.clea.no
# BETTER_AUTH_SECRET=<same value as Railway API>
# AUTH_DATABASE_URL=<Neon pooler URL>?sslmode=require
# RESEND_API_KEY=<resend key>
# AUTH_EMAIL_FROM=Clea <noreply@clea.no>
# BETTER_AUTH_CROSS_SUBDOMAIN_COOKIES=true
# BETTER_AUTH_COOKIE_DOMAIN=.clea.no
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Sentry (optional in dev; recommended in production)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
